+/*
+ * niu-git: accept POSIX-shaped path arguments.
+ *
+ * Official Git for Windows gets "/d/repo" style arguments converted by
+ * the MSYS2 runtime; this native build has no such conversion layer.
+ * Rewrite an argument only when it is *unambiguous* and *safe*:
+ *
+ *   - it looks like "/x/..." or "/x" with x a single letter
+ *     (drive-backed POSIX path), or like "/x:/..." / "/x:" (leading
+ *     slash + drive prefix),
+ *   - it spells the same drive through one of the family's other
+ *     mount prefixes, "/mnt/x/..." or "/cygdrive/x/..." (the forms
+ *     rubash and WinuxCmd accept for the same drive), or
+ *   - it is "/tmp" or "/tmp/...", and
+ *   - the literal path does not exist, but the converted Windows path
+ *     ("x:/...", "x:/", the temp directory) does.
+ *
+ * "/tmp" is the one form whose existence check is one-sided: the
+ * family mounts /tmp on the session temp directory (%TEMP%), so the
+ * converted candidate is checked, but the literal "<cwd-drive>:\tmp"
+ * must not veto the rewrite -- that drive-root fallback is exactly
+ * the cwd-dependent landing the mount replaces, and in the family
+ * dialect "/tmp" always names the temp mount. Bare-slash prefixes
+ * with no family mount ("/usr/bin", ...) deliberately keep the
+ * native drive-root fallback.
+ *
+ * Anything else is passed through untouched; when both spellings fail
+ * to exist the original literal is kept so error messages and pathspecs
+ * stay unchanged.
+ *
+ * unixwin/niu-git#18.
+ */
+static int wargv_is_drive_letter(wchar_t c)
+{
+	return (L'a' <= c && c <= L'z') || (L'A' <= c && c <= L'Z');
+}
+
+/*
+ * "/mnt/<x>/..." and "/cygdrive/<x>/..." mount the drive <x> exactly
+ * like "/<x>/..." does; return a pointer at the drive letter, or NULL
+ * when arg is not one of those forms.
+ */
+static const wchar_t *wargv_mount_drive(const wchar_t *arg)
+{
+	if (!wcsncmp(arg, L"/mnt/", 5))
+		arg += 5;
+	else if (!wcsncmp(arg, L"/cygdrive/", 10))
+		arg += 10;
+	else
+		return NULL;
+	if (wargv_is_drive_letter(arg[0]) && (arg[1] == L'/' || !arg[1]))
+		return arg;
+	return NULL;
+}
+
+static int wargv_is_tmp_form(const wchar_t *arg)
+{
+	return !wcsncmp(arg, L"/tmp", 4) && (arg[4] == L'/' || !arg[4]);
+}
+
+static int wargv_looks_like_posix_path(const wchar_t *arg)
+{
+	if (arg[0] != L'/' || !arg[1])
+		return 0;
+	if (wargv_is_drive_letter(arg[1])) {
+		/* "/x/..." or "/x" */
+		if (arg[2] == L'/' || !arg[2])
+			return 1;
+		/* "/x:/..." or "/x:" */
+		if (arg[2] == L':' && (arg[3] == L'/' || !arg[3]))
+			return 1;
+	}
+	/* "/mnt/x/...", "/cygdrive/x/...", "/tmp", "/tmp/..." */
+	return wargv_mount_drive(arg) != NULL || wargv_is_tmp_form(arg);
+}
+
+static wchar_t *wargv_convert_posix_path(const wchar_t *arg)
+{
+	const wchar_t *mount;
+	wchar_t *converted;
+
+	if (wargv_is_tmp_form(arg)) {
+		wchar_t tmp[MAX_PATH];
+		DWORD n = GetTempPathW(ARRAY_SIZE(tmp), tmp);
+		size_t len;
+
+		if (!n || n >= ARRAY_SIZE(tmp))
+			return NULL;
+		/* the temp path ends in a separator; drop it so the
+		 * "/..." remainder can be appended verbatim */
+		while (n > 1 && (tmp[n - 1] == L'\\' || tmp[n - 1] == L'/'))
+			tmp[--n] = L'\0';
+		len = n + wcslen(arg + 4);
+		converted = malloc_startup((len + 1) * sizeof(wchar_t));
+		wcscpy(converted, tmp);
+		wcscat(converted, arg + 4);
+		return converted;
+	}
+	mount = wargv_mount_drive(arg);
+	if (mount) {
+		/* "/mnt/x/rest" -> "x:/rest"; "/mnt/x" -> "x:/" */
+		converted = malloc_startup((wcslen(mount) + 3) *
+					   sizeof(wchar_t));
+		converted[0] = mount[0];
+		converted[1] = L':';
+		wcscpy(converted + 2, mount[1] ? mount + 1 : L"/");
+		return converted;
+	}
+	if (arg[2] == L':') {
+		/* "/x:/rest" -> "x:/rest" */
+		converted = malloc_startup(wcslen(arg) * sizeof(wchar_t));
+		wcscpy(converted, arg + 1);
+		return converted;
+	}
+	/* "/x/rest" -> "x:/rest"; "/x" -> "x:/" */
+	converted = malloc_startup((wcslen(arg) + 2) * sizeof(wchar_t));
+	converted[0] = arg[1];
+	converted[1] = L':';
+	wcscpy(converted + 2, arg[2] ? arg + 2 : L"/");
+	return converted;
+}
+
+static const wchar_t *maybe_convert_posix_path_arg(const wchar_t *arg)
+{
+	wchar_t *converted;
+
+	if (!wargv_looks_like_posix_path(arg))
+		return arg;
+	/*
+	 * A literal that already names an existing path wins, except
+	 * for the "/tmp" form (see the header comment): there the
+	 * literal's existence is the drive-root fallback itself.
+	 */
+	if (!wargv_is_tmp_form(arg) &&
+	    GetFileAttributesW(arg) != INVALID_FILE_ATTRIBUTES)
+		return arg;
+
+	converted = wargv_convert_posix_path(arg);
+	if (!converted)
+		return arg;
+	if (GetFileAttributesW(converted) == INVALID_FILE_ATTRIBUTES) {
+		free(converted);
+		return arg;
+	}
+	return converted;
+}
+
+/*
+ * niu-git: message option values are payload text, not paths. Never
+ * POSIX-convert the token following these options (commit/tag/notes
+ * "-m <msg>" and "--message <msg>"). Attached value forms (-m<val>,
+ * --message=<val>) are single tokens starting with '-' and can never
+ * look like a POSIX path, so only the detached forms need the guard.
+ * -F/--file values are genuine file paths and keep benefiting from
+ * the exists-checked conversion.
+ */
+static int wargv_value_is_message(int i, const wchar_t **wargv)
+{
+	const wchar_t *prev;
+
+	if (i < 1)
+		return 0;
+	prev = wargv[i - 1];
+	return !wcscmp(prev, L"-m") || !wcscmp(prev, L"--message");
+}
+
 /*
