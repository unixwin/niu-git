  * normally ignore main(), but we call the latter from the former
@@ -4433,7 +4599,10 @@ int wmain(int argc, const wchar_t **wargv)
 	/* determine size of argv and environ conversion buffer */
 	maxlen = wcslen(wargv[0]);
 	for (i = 1; i < argc; i++)
-		maxlen = max(maxlen, wcslen(wargv[i]));
+		/* POSIX path conversion can grow an argument: the drive
+		 * forms by one char, the "/tmp" form by up to the whole
+		 * temp directory path (bounded by MAX_PATH) */
+		maxlen = max(maxlen, wcslen(wargv[i]) + 1 + MAX_PATH);
 
 	/* allocate buffer (wchar_t encodes to max 3 UTF-8 bytes) */
 	maxlen = 3 * maxlen + 1;
@@ -4446,8 +4615,15 @@ int wmain(int argc, const wchar_t **wargv)
 	 */
 	ALLOC_ARRAY(argv, argc + 1);
 	ALLOC_ARRAY(save, argc + 1);
-	for (i = 0; i < argc; i++)
-		argv[i] = save[i] = wcstoutfdup_startup(buffer, wargv[i], maxlen);
+	for (i = 0; i < argc; i++) {
+		/* skip argv[0]: never rewrite the program name; and never
+		 * rewrite message payloads (wargv_value_is_message) - commit
+		 * messages are literal bytes, not path candidates */
+		const wchar_t *warg = (i && !wargv_value_is_message(i, wargv))
+					? maybe_convert_posix_path_arg(wargv[i])
+					: wargv[i];
+		argv[i] = save[i] = wcstoutfdup_startup(buffer, warg, maxlen);
+	}
 	argv[i] = save[i] = NULL;
 	free(buffer);
 
